# ==========================================
# VisionVoice Environment Configuration
# ==========================================

# Platform Configuration: 'mac' or 'pi'
PLATFORM=mac

# Camera Backend: 'mac' (OpenCV VideoCapture) or 'pi' (Picamera2)
CAMERA_BACKEND=mac
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# Audio / TTS Backend: 'mac' (macOS native say) or 'pi' (espeak-ng / aplay)
AUDIO_BACKEND=mac
PI_AUDIO_DEVICE=plughw:3,0
SPEECH_SPEED=175
SPEECH_VOLUME=1.0

# OCR Supported Languages Configuration
# VisionVoice automatically runs a fast Stage-1 script probe and selects targeted language models:
# (English -> eng, Tamil -> tam+eng, Kannada -> kan+eng, Telugu -> tel+eng, Malayalam -> mal+eng, Hindi -> hin+eng)
SUPPORTED_LANGUAGES=eng,tam,kan,tel,mal,hin
OCR_CONFIDENCE_THRESHOLD=40.0
OCR_FAST_MODE=false
OCR_MAX_VARIANTS=4
OCR_MAX_PSM=2
OCR_EARLY_STOP_SCORE=85.0

# Tesseract executable override (leave empty to use system PATH)
# macOS Homebrew: /opt/homebrew/bin/tesseract
# Linux / Pi: /usr/bin/tesseract
TESSERACT_CMD=
TESSDATA_PREFIX=

# Page Alignment & Stability Detection
PAGE_STABILITY_FRAMES=4
PAGE_MIN_AREA_RATIO=0.15
PAGE_MAX_MOVEMENT_THRESHOLD=0.03
PAGE_DETECTION_FPS=10

# Translation & Preferences
DEFAULT_LANGUAGE=en
TRANSLATION_ENABLED=false
TARGET_TRANSLATION_LANGUAGE=en

# Hardware / GPIO Pins (Raspberry Pi only)
PIN_BUTTON_POWER=17
PIN_BUTTON_VOL_UP=27
PIN_BUTTON_VOL_DOWN=22
PIN_LED_STATUS=24

# Development & Debug Settings
DEBUG_MODE=true
SHOW_CAMERA_PREVIEW=false
SAVE_INTERMEDIATE_IMAGES=true
